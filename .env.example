# AnimaWatch MCP Server Configuration
# Copy this file to .env and fill in your values

# =============================================================================
# VISION AI PROVIDER (optional: frame timing works without it)
# =============================================================================

# gemini (your own key), ollama (local) or none
# VISION_PROVIDER=gemini

# Your own Google Gemini API key (https://aistudio.google.com/).
# Without a key, vision is off. If you make an app available to users in the
# UK, the EEA or Switzerland, Google's terms require a paid (billing-enabled) key.
GEMINI_API_KEY=

# Gemini model for the vision pass (must accept video)
VISION_MODEL=gemini-3.8-flash

# =============================================================================
# OLLAMA (optional: local vision, needs the ollama extra and ffmpeg)
# =============================================================================

# VISION_PROVIDER=ollama
# OLLAMA_HOST=http://localhost:11434
# OLLAMA_MODEL=qwen2.5-vl:7b

# =============================================================================
# BROWSER SETTINGS
# =============================================================================

# Run browser in headless mode (default: true)
BROWSER_HEADLESS=true

# Video recording settings
VIDEO_WIDTH=1280
VIDEO_HEIGHT=720

# Upper bound in seconds on every wait (wait_time, duration, 'wait' actions)
MAX_RECORDING_DURATION=30

# Launch this Chromium instead of Playwright's bundled one (optional)
# BROWSER_EXECUTABLE_PATH=/path/to/chrome

# Judge frame timing against this refresh rate instead of measuring it (optional)
# REFRESH_RATE_HZ=60

# Allow file:// URLs (default: true)
# ALLOW_FILE_URLS=true

# =============================================================================
# SERVER SETTINGS
# =============================================================================

# Server host and port for `animawatch --http` (streamable HTTP at /mcp)
SERVER_HOST=127.0.0.1
SERVER_PORT=8765

# Extra host names (comma-separated) accepted in Host/Origin headers, e.g. a
# reverse proxy's domain. Localhost and the bind address are always accepted.
# ALLOWED_HOSTS=mcp.example.com

# Directory to store recordings (default: temp directory)
# RECORDINGS_DIR=/path/to/recordings

